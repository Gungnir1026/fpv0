{
  "additional_data": {
    "elevation": "/custom_files/elevation_data"
  },
  "httpd": {
    "service": {
      "listen": "tcp://0.0.0.0:8002",
      "loopback": "ipc:///tmp/valhalla",
      "interrupt": "ipc:///tmp/interrupt",
      "drain_seconds": 28,
      "shutdown_seconds": 1,
      "timeout_seconds": -1
    }
  },
  "loki": {
    "actions": [
      "locate",
      "route",
      "sources_to_targets",
      "optimized_route",
      "isochrone",
      "trace_route",
      "trace_attributes",
      "height",
      "transit_available",
      "expansion",
      "status"
    ],
    "logging": {
      "color": true,
      "file_name": "",
      "long_request": 100.0,
      "type": "std_out"
    },
    "service_defaults": {
      "heading_tolerance": 60,
      "minimum_reachability": 50,
      "node_snap_tolerance": 5,
      "radius": 0,
      "search_cutoff": 35000,
      "street_side_max_distance": 1000,
      "street_side_tolerance": 5,
      "mvt_min_zoom_road_class": [
        7,
        7,
        8,
        11,
        11,
        12,
        13,
        14
      ],
      "mvt_cache_min_zoom": 11,
      "mvt_max_age": "1800"
    },
    "use_connectivity": true,
    "service": {
      "proxy": "ipc:///tmp/loki"
    }
  },
  "meili": {
    "breakage_distance": 2000,
    "default_search_radius": 50,
    "gps_accuracy": 5.0,
    "interpolation_distance": 10,
    "max_route_distance_factor": 5,
    "max_route_time_factor": 5,
    "mode": "auto",
    "search_radius": 100,
    "sigma_z": 4.07,
    "turn_penalty_factor": 200,
    "customizable": [
      "mode",
      "search_radius",
      "turn_penalty_factor",
      "gps_accuracy",
      "interpolation_distance",
      "sigma_z",
      "beta",
      "max_route_distance_factor",
      "max_route_time_factor"
    ],
    "verbose": false,
    "default": {
      "sigma_z": 4.07,
      "gps_accuracy": 5.0,
      "beta": 3,
      "max_route_distance_factor": 5,
      "max_route_time_factor": 5,
      "max_search_radius": 100,
      "breakage_distance": 2000,
      "interpolation_distance": 10,
      "search_radius": 50,
      "geometry": false,
      "route": true,
      "turn_penalty_factor": 0
    },
    "auto": {
      "turn_penalty_factor": 200,
      "search_radius": 50
    },
    "pedestrian": {
      "turn_penalty_factor": 100,
      "search_radius": 50
    },
    "bicycle": {
      "turn_penalty_factor": 140
    },
    "multimodal": {
      "turn_penalty_factor": 70
    },
    "service": {
      "proxy": "ipc:///tmp/meili"
    },
    "grid": {
      "size": 500,
      "cache_size": 100240
    }
  },
  "mjolnir": {
    "admin": "/custom_files/admins.sqlite",
    "data_processing": {
      "infer_internal_intersections": true,
      "use_admin_db": true,
      "use_direction_on_ways": false,
      "infer_turn_channels": true,
      "apply_country_overrides": true,
      "grid_divisions_within_tile": 32,
      "allow_alt_name": false,
      "use_urban_tag": false,
      "use_rest_area": false,
      "scan_tar": false
    },
    "global_synchronized_cache": false,
    "hierarchy": true,
    "include_bicycle": true,
    "include_driveways": true,
    "include_driving": true,
    "include_pedestrian": true,
    "include_service": true,
    "logging": {
      "color": true,
      "file_name": "",
      "long_request": 100.0,
      "type": "std_out"
    },
    "max_cache_size": 1000000000,
    "shortcuts": true,
    "tile_dir": "/custom_files/taiwan_custom",
    "tile_extract": "/custom_files/taiwan_custom.tar",
    "timezone": "/custom_files/timezones.sqlite",
    "traffic_extract": "/custom_files/traffic.tar",
    "id_table_size": 1300000000,
    "use_lru_mem_cache": false,
    "lru_mem_cache_hard_control": false,
    "use_simple_mem_cache": false,
    "landmarks": "/data/valhalla/landmarks.sqlite",
    "transit_dir": "/custom_files/transit_tiles",
    "transit_feeds_dir": "/gtfs_feeds",
    "transit_pbf_limit": 20000,
    "keep_all_osm_node_ids": false,
    "keep_osm_node_ids": false,
    "include_platforms": false,
    "include_construction": false,
    "import_bike_share_stations": false,
    "max_concurrent_reader_users": 1,
    "reclassify_links": true,
    "concurrency": "2",
    "default_speeds_config": "/custom_files/default_speeds.json"
  },
  "odin": {
    "logging": {
      "color": true,
      "file_name": "",
      "long_request": 100.0,
      "type": "std_out"
    },
    "markup_formatter": {
      "markup_enabled": false,
      "phoneme_format": "<TEXTUAL_STRING> (<span class=<QUOTES>phoneme<QUOTES>>/<VERBAL_STRING>/</span>)"
    },
    "service_defaults": {
      "directions_type": "instructions",
      "language": "zh-TW",
      "units": "kilometers"
    },
    "service": {
      "proxy": "ipc:///tmp/odin"
    }
  },
  "service_limits": {
    "allow_hard_exclusions": true,
    "auto": {
      "max_distance": 500000,
      "max_locations": 20,
      "max_matrix_distance": 400000.0,
      "max_matrix_location_pairs": 2500
    },
    "bicycle": {
      "max_distance": 250000,
      "max_locations": 20,
      "max_matrix_distance": 200000.0,
      "max_matrix_location_pairs": 2500
    },
    "motor_scooter": {
      "max_distance": 300000,
      "max_locations": 20,
      "max_matrix_distance": 200000.0,
      "max_matrix_location_pairs": 2500
    },
    "motorcycle": {
      "max_distance": 500000,
      "max_locations": 20,
      "max_matrix_distance": 200000.0,
      "max_matrix_location_pairs": 2500
    },
    "pedestrian": {
      "max_distance": 250000,
      "max_locations": 20,
      "max_matrix_distance": 200000.0,
      "max_matrix_location_pairs": 2500,
      "min_multimodal_walking_distance": 1,
      "max_multimodal_walking_distance": 10000
    },
    "trace": {
      "max_distance": 200000,
      "max_gps_accuracy": 100,
      "max_search_radius": 200,
      "max_shape": 16000,
      "max_alternates": 3,
      "max_alternates_shape": 100
    },
    "bus": {
      "max_distance": 5000000.0,
      "max_locations": 50,
      "max_matrix_distance": 400000.0,
      "max_matrix_location_pairs": 2500
    },
    "taxi": {
      "max_distance": 5000000.0,
      "max_locations": 20,
      "max_matrix_distance": 400000.0,
      "max_matrix_location_pairs": 2500
    },
    "multimodal": {
      "max_distance": 500000.0,
      "max_locations": 50,
      "max_matrix_distance": 0.0,
      "max_matrix_location_pairs": 0
    },
    "status": {
      "allow_verbose": false
    },
    "transit": {
      "max_distance": 500000.0,
      "max_locations": 50,
      "max_matrix_distance": 200000.0,
      "max_matrix_location_pairs": 2500
    },
    "truck": {
      "max_distance": 5000000.0,
      "max_locations": 20,
      "max_matrix_distance": 400000.0,
      "max_matrix_location_pairs": 2500
    },
    "skadi": {
      "max_shape": 750000,
      "min_resample": 10.0
    },
    "isochrone": {
      "max_contours": 4,
      "max_time_contour": 120,
      "max_distance": 25000.0,
      "max_locations": 1,
      "max_distance_contour": 200
    },
    "bikeshare": {
      "max_distance": 500000.0,
      "max_locations": 50,
      "max_matrix_distance": 200000.0,
      "max_matrix_location_pairs": 2500
    },
    "auto_pedestrian": {
      "max_distance": 5000000.0,
      "max_matrix_distance": 400000.0,
      "max_matrix_location_pairs": 2500
    },
    "centroid": {
      "max_distance": 200000.0,
      "max_locations": 5
    },
    "max_exclude_locations": 50,
    "max_reachability": 100,
    "max_radius": 200,
    "max_timedep_distance": 500000,
    "max_timedep_distance_matrix": 0,
    "max_alternates": 2,
    "max_exclude_polygons_length": 10000,
    "min_linear_cost_factor": 1,
    "max_linear_cost_edges": 50000,
    "max_distance_disable_hierarchy_culling": 0,
    "hierarchy_limits": {
      "allow_modification": false,
      "costmatrix": {
        "max_allowed_up_transitions": {
          "1": 400,
          "2": 100
        },
        "max_expand_within_distance": {
          "0": 100000000.0,
          "1": 100000,
          "2": 5000
        }
      },
      "unidirectional_astar": {
        "max_allowed_up_transitions": {
          "1": 400,
          "2": 100
        },
        "max_expand_within_distance": {
          "0": 100000000.0,
          "1": 100000,
          "2": 5000
        }
      },
      "bidirectional_astar": {
        "max_allowed_up_transitions": {
          "1": 400,
          "2": 100
        },
        "max_expand_within_distance": {
          "0": 100000000.0,
          "1": 20000,
          "2": 5000
        }
      }
    }
  },
  "thor": {
    "logging": {
      "color": true,
      "file_name": "",
      "long_request": 100.0,
      "type": "std_out"
    },
    "max_reserved_labels_count": 2000000,
    "source_to_target_algorithm": "select_optimal",
    "timedep_forward": true,
    "service": {
      "proxy": "ipc:///tmp/thor"
    },
    "max_reserved_labels_count_astar": 2000000,
    "max_reserved_labels_count_bidir_astar": 1000000,
    "max_reserved_labels_count_dijkstras": 4000000,
    "max_reserved_labels_count_bidir_dijkstras": 2000000,
    "clear_reserved_memory": false,
    "extended_search": false,
    "costmatrix": {
      "check_reverse_connection": true,
      "allow_second_pass": false,
      "max_reserved_locations": 25,
      "max_iterations": 2800,
      "min_iterations": 100,
      "hierarchy_limits": {
        "max_up_transitions": {
          "1": 400,
          "2": 100
        },
        "expand_within_distance": {
          "0": 100000000.0,
          "1": 20000,
          "2": 5000
        }
      }
    },
    "bidirectional_astar": {
      "threshold_delta": 420.0,
      "alternative_cost_extend": 1.2,
      "alternative_iterations_delta": 100000,
      "hierarchy_limits": {
        "max_up_transitions": {
          "1": 400,
          "2": 100
        },
        "expand_within_distance": {
          "0": 100000000.0,
          "1": 20000,
          "2": 5000
        }
      }
    },
    "unidirectional_astar": {
      "hierarchy_limits": {
        "max_up_transitions": {
          "1": 400,
          "2": 100
        },
        "expand_within_distance": {
          "0": 100000000.0,
          "1": 100000,
          "2": 5000
        }
      }
    }
  },
  "tile_extract": "/custom_files/taiwan_custom.tar",
  "tyr": {
    "logging": {
      "color": true,
      "file_name": "",
      "long_request": 100.0,
      "type": "std_out"
    },
    "service_defaults": {
      "format": "json"
    }
  },
  "logging": {
    "type": "std_out",
    "color": true,
    "file_name": "path_to_some_file.log"
  },
  "statsd": {
    "port": 8125,
    "prefix": "valhalla",
    "batch_size": 500
  }
}
