POSTGRES_DB=tw_nav
POSTGRES_USER=tw_nav
POSTGRES_PASSWORD=tw_nav_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://tw_nav:tw_nav_dev_password@localhost:5432/tw_nav

VALHALLA_PORT=8002
VALHALLA_BASE_URL=http://localhost:8002
VALHALLA_SERVER_THREADS=2

FACADE_HOST=127.0.0.1
FACADE_PORT=8010
NAVIGATION_API_BASE_URL=http://localhost:8010
ANDROID_NAVIGATION_API_BASE_URL=http://10.0.2.2:8010

TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
TDX_AUTH_URL=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token
TDX_API_BASE_URL=https://tdx.transportdata.tw/api/basic/v2

# 確認 TDX Swagger 或資料目錄中的 dataset 路徑後再填入。
# 可填完整 URL，或相對於 TDX_API_BASE_URL 的路徑。
TDX_WAITING_ZONES_ENDPOINT=
TDX_LANE_RESTRICTIONS_ENDPOINT=

# 選用的 OData JSON 參數。建議保留 $format=JSON，讓解析結果穩定。
TDX_WAITING_ZONES_PARAMS={}
TDX_LANE_RESTRICTIONS_PARAMS={}

# 臺北市大安區概略 bbox：min_lon,min_lat,max_lon,max_lat。
INGEST_BBOX=121.5150,25.0150,121.5650,25.0500

FUSION_OUTPUT_PBF=infra/valhalla/custom_files/taiwan_custom.pbf
FUSION_SCHEMA=fusion
FUSION_BATCH_SIZE=5000
FUSION_BBOX_MARGIN_DEGREES=0.02
OSMIUM_LOCATION_INDEX=flex_mem
WAITING_ZONE_BUFFER_M=35
LANE_RESTRICTION_BUFFER_M=25
DEFAULT_MOTORCYCLE_LANE_PATTERN=no|yes|yes

# MVP 預設使用的臺北市開放資料。
# 資料集：
# - 臺北市機車例外管制路口列表
# - 臺北市平面道路禁行機車
TAIPEI_CITY=臺北市
TAIPEI_DISTRICT=大安區
TAIPEI_RAW_DIR=data/raw/taipei
TAIPEI_TWO_STAGE_TURN_URL=https://data.taipei/api/frontstage/tpeod/dataset/resource.download?rid=86c7c859-78d4-430c-bada-277203abd881
TAIPEI_DIRECT_LEFT_URL=https://data.taipei/api/frontstage/tpeod/dataset/resource.download?rid=e77ab72d-cffa-46be-8b5c-16d60c32fce5
TAIPEI_OPEN_THIRD_LANE_URL=https://data.taipei/api/frontstage/tpeod/dataset/resource.download?rid=a15f2a8d-eb1a-489d-a25f-3d816af10177
TAIPEI_MOTORCYCLE_BAN_URL=https://data.taipei/api/frontstage/tpeod/dataset/resource.download?rid=2c833533-071f-4b3c-9d17-39662d805b66
